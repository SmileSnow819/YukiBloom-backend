# 复制为 .env 后填写自己的密码；.env 不会提交到 Git。

# PostgreSQL
POSTGRES_USER=yukibloom
POSTGRES_DB=yukibloom
POSTGRES_PASSWORD=replace-with-long-random-hex

# 本地访问 http://127.0.0.1:<API_PORT>
API_PORT=8080
COOKIE_SECURE=false

# 图片统一存储至 COS；桶内图片需允许公有读、私有写。
COS_BUCKET=yukibloom-1379189818
COS_REGION=ap-shanghai
COS_PUBLIC_BASE_URL=https://yukibloom-1379189818.cos.ap-shanghai.myqcloud.com
# 在腾讯云创建仅限此桶读写对象的服务端凭证；不要提交真实密钥。
COS_SECRET_ID=
COS_SECRET_KEY=

# 管理员（密码至少 12 位）
ADMIN_USERNAME=your-admin-name
ADMIN_PASSWORD=replace-with-your-password
# 创建账号：set -a && source .env && set +a
# docker compose exec -e ADMIN_USERNAME -e ADMIN_PASSWORD api /create-admin

# 直接运行 Go 服务时使用
# DATABASE_URL=postgres://yukibloom:password@127.0.0.1:5432/yukibloom?sslmode=disable
# PORT=8080

# 独立测试数据库
# TEST_DATABASE_URL=postgres://yukibloom:password@127.0.0.1:5432/yukibloom_test?sslmode=disable
